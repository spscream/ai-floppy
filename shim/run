#!/usr/bin/env bash
# The only file of this plugin that lands in a consumer repository, as
# .floppy/run. It does two things nobody else may do: locate the plugin, and
# parse .floppy/config. Everything downstream reads FLOPPY_* from the
# environment, so there is exactly one parser and one search order.
set -uo pipefail

# Loud on purpose: every verb below trusts FLOPPY_REPO as the root all its
# paths are relative to. A silent `|| pwd` fallback here would mean a run
# from outside any git repository quietly derives every downstream path —
# memory dir, statuses file, watched dirs — from the wrong place instead of
# failing where the mistake is obvious.
if ! FLOPPY_REPO="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "x not inside a git repository: $(pwd)" >&2
  echo "  floppy's session ritual is git-based; cd into the repository first" >&2
  exit 1
fi
export FLOPPY_REPO

# The plugin cache path carries a version (Claude Code) or a git commit SHA
# (Cursor) in its last segment and changes on every update, so the only
# stable handles across both harnesses are the harness-set variable and an
# explicit override.
#
# Each candidate below only counts if it actually has SCRIPTS in scripts/ —
# a cache entry that exists but is mid-write, or a stale leftover from a
# broken install, must not be trusted just because it is the newest thing on
# disk. The directory alone is not evidence, and testing for it was not
# enough: on 2026-08-25 Claude Code held a cache from a moment when scripts/
# held only .gitkeep, `claude plugin update` called it "already at the latest
# version" because the version string had not moved, and every verb died with
# "No such file or directory" from inside the resolved root. Gating on at
# least one *.sh makes that candidate fall through to the next layout, or to
# the install hint below — which is what a broken install should produce.
#
# skills/init/SKILL.md duplicates this exact search rather than sourcing it
# from here: `init` runs before this file exists in the target repository
# (creating it is init's own first step), so it cannot read this copy. Keep
# the two in sync by hand if this search ever changes.
has_scripts() { [[ -n "${1:-}" ]] && ls "$1"/scripts/*.sh >/dev/null 2>&1; }
claude_cache="$(ls -d "$HOME"/.claude/plugins/cache/*/floppy/*/ 2>/dev/null | sort -V | tail -n1)"
cursor_local="$HOME/.cursor/plugins/local/floppy"
# Cursor's cache path ends in a git commit SHA, not a version — measured on
# the owner's own machine:
#   ~/.cursor/plugins/cache/floppy/floppy/ed18232fd3b616d570a707fb8464b678b8542dbf
# Sorting SHAs with `sort -V` (or any lexicographic sort) orders them by hash
# value, which has no relationship to recency at all: on a machine with two
# cached copies it would silently pick an arbitrary one, quite possibly the
# stale one — exactly the failure mode this whole guard exists to prevent.
# `ls -dt` sorts candidate directories by modification time instead, which
# is what "newest" actually means here, and it does so portably across BSD
# (macOS) and GNU `ls` without touching `stat`'s incompatible flags. Kept as
# a second, separate lookup rather than unified with claude_cache's sort -V:
# a mechanism correct for a version-named directory is not correct for a
# SHA-named one, and unifying them would make one of the two wrong.
cursor_cache="$(ls -dt "$HOME"/.cursor/plugins/cache/*/floppy/*/ 2>/dev/null | head -n1)"

if   has_scripts "${CLAUDE_PLUGIN_ROOT:-}"; then
  FLOPPY_ROOT="$CLAUDE_PLUGIN_ROOT"
elif has_scripts "${AI_FLOPPY_HOME:-}"; then
  FLOPPY_ROOT="$AI_FLOPPY_HOME"
elif has_scripts "$claude_cache"; then
  FLOPPY_ROOT="$claude_cache"
elif has_scripts "$cursor_local"; then
  FLOPPY_ROOT="$cursor_local"
elif has_scripts "$cursor_cache"; then
  FLOPPY_ROOT="$cursor_cache"
fi

if ! has_scripts "${FLOPPY_ROOT:-}"; then
  echo "x floppy plugin not found." >&2
  echo "  Claude Code:  /plugin marketplace add spscream/ai-floppy && /plugin install floppy" >&2
  echo "  Cursor:       Dashboard -> Plugins -> Add Marketplace -> Import from Repo (spscream/ai-floppy)" >&2
  echo "  Cursor (dev): ln -s /path/to/ai-floppy ~/.cursor/plugins/local/floppy" >&2
  echo "  Or point AI_FLOPPY_HOME at a checkout directly." >&2
  echo "  A cache directory that exists but holds no scripts/*.sh counts as not found:" >&2
  echo "  reinstall rather than trusting \`plugin update\`, which is a no-op while the version is unchanged." >&2
  exit 1
fi
export FLOPPY_ROOT

# Is this copy the same file as the plugin's? Both are on disk now, so the
# question is one `cmp` away.
#
# Why every call and not just a red one: this file is a COPY in the consumer
# repository and does not arrive with `plugin update`, and the ways it goes
# stale are mostly SILENT. A missing verb announces itself; a fixed config
# parser, a fixed repository resolver, a corrected search order do not — the
# old copy simply keeps doing the old thing. Measured over the first week after
# extraction: the shim took 9 commits, and 4 of the 8 after the first were in
# the plugin resolver — the one part that by construction cannot move into the
# plugin, so no amount of shrinking this file removes them. A content
# comparison covers all 8.
#
# The hint is a bare `cp` rather than a verb like `refresh` on purpose: a shim
# old enough to need refreshing is by definition too old to know the verb that
# would do it.
#
# Silent when the plugin ships no shim/ (some install layouts flatten it) —
# a check with nothing to compare against must not invent a warning. Silent
# too when this IS the plugin's own copy, which is the case while developing
# the plugin itself.
self="${BASH_SOURCE[0]:-$0}"
plugin_shim="$FLOPPY_ROOT/shim/run"
if [[ -f "$self" && -f "$plugin_shim" ]] && ! cmp -s "$self" "$plugin_shim"; then
  echo "! .floppy/run differs from the installed plugin's shim — usually stale: cp \"$plugin_shim\" \"$FLOPPY_REPO/.floppy/run\"" >&2
fi

# Flat key=value, like quota.lock. Nested YAML cannot be parsed by bash 3.2
# without a hand-rolled parser, and a hand-rolled config parser fails quietly.
cfg="$FLOPPY_REPO/.floppy/config"
cfg_get() { # key default
  local line="" v=""
  [[ -f "$cfg" ]] && line="$(grep -m1 "^[[:space:]]*$1[[:space:]]*=" "$cfg" 2>/dev/null || true)"
  if [[ -z "$line" ]]; then printf '%s' "$2"; return; fi
  v="${line#*=}"
  v="${v#"${v%%[![:space:]]*}"}"   # leading
  v="${v%"${v##*[![:space:]]}"}"   # trailing
  printf '%s' "$v"
}

# memory_language is deliberately not exported: it governs the language a
# note's prose is written in, which is a convention the agent reads out of
# .floppy/config directly (see floppy:agent-memory) — no script here acts on
# it. An env var nothing consumes is worse than no var: it looks wired.
export FLOPPY_MEMORY_DIR="$(cfg_get memory_dir .agent-memory)"

# Is the memory inside this repository, or hosted in another one?
#
# Some consumers cannot commit memory next to the code — a client's checkout
# they do not own, or a policy against agent notes in the code repository. For
# those, memory_dir is a symlink (or an absolute path) into a separate git
# repository, and the whole rite has to close two repositories instead of one.
#
# DERIVED, never configured. A boolean in .floppy/config would be a second
# source of truth about a thing the filesystem already knows, and the two would
# disagree exactly when it matters: a symlink that failed to get created reads
# as "external" in the config while every write lands in an ordinary directory
# inside the repository, where the ignore rule then hides it. Resolving the
# path cannot be wrong about where a write goes.
#
# `cd && pwd -P` rather than `realpath`/`readlink -f`: macOS ships neither in
# the form used here (BSD readlink has no -f), and this must run on bash 3.2.
case "$FLOPPY_MEMORY_DIR" in
  /*) _mem_abs="$FLOPPY_MEMORY_DIR" ;;
  *)  _mem_abs="$FLOPPY_REPO/$FLOPPY_MEMORY_DIR" ;;
esac
if [[ -d "$_mem_abs" ]]; then _mem_real="$(cd "$_mem_abs" && pwd -P)"; else _mem_real="$_mem_abs"; fi
_repo_real="$(cd "$FLOPPY_REPO" && pwd -P)"
case "$_mem_real/" in
  "$_repo_real"/*) FLOPPY_MEMORY_EXTERNAL=0 ;;
  *)               FLOPPY_MEMORY_EXTERNAL=1 ;;
esac
# The store's own git root, not the memory directory: a memory hosted at
# projects/<key>/memory inside a bigger repository is committed at that
# repository's root. Empty when the memory is internal, and empty too when the
# resolved path is outside this repository but not in any git repository at
# all — which is a real setup (a plain directory in $HOME) that the rite must
# report rather than pretend it can push.
FLOPPY_MEMORY_STORE=""
if [[ "$FLOPPY_MEMORY_EXTERNAL" == "1" && -d "$_mem_real" ]]; then
  FLOPPY_MEMORY_STORE="$(git -C "$_mem_real" rev-parse --show-toplevel 2>/dev/null || true)"
fi
export FLOPPY_MEMORY_EXTERNAL FLOPPY_MEMORY_STORE
export FLOPPY_MEMORY_REAL="$_mem_real"
export FLOPPY_WORKPLACE_REPO="$(cfg_get workplace_repo '')"
# One key names this project in every memory repository it uses, and it is
# also the directory a human opens under agents_memory_dir. The two older,
# per-purpose keys stay as overrides, for the project whose scope really is
# named differently in the two repositories — that case exists, which is why
# they are not simply deleted, but it is not the common one and it should not
# be what a fresh config asks about.
export FLOPPY_PROJECT_KEY="$(cfg_get project_key '')"
export FLOPPY_WORKPLACE_PROJECT_KEY="$(cfg_get workplace_project_key "$FLOPPY_PROJECT_KEY")"

# ---------- where a memory checkout lives ----------
# One PARENT directory holds one checkout per repository URL, and the checkout
# directory is derived from the URL rather than configured.
#
# It used to be configured, once per purpose: memory_repo_dir for the store and
# workplace_memory_dir for the workplace repository, both defaulting to
# $HOME/agents_memory. Two keys with one default is a collision waiting for
# somebody to configure both, and the collision was silent — measured
# 2026-08-25: the first verb cloned its repository there, the second found a
# .git, skipped its clone, never compared the remote, and reported "a write
# through the link lands in the workplace repository" while the notes were
# landing in the store and would have been pushed there.
#
# Deriving the directory from the URL removes the class rather than the case:
# two URLs cannot name one directory, and one URL used for both purposes
# deliberately shares a checkout, which is correct — two checkouts of one
# repository on one machine fight over pulls instead.
FLOPPY_AGENTS_MEMORY_DIR="$(cfg_get agents_memory_dir "$HOME/agents_memory")"
export FLOPPY_AGENTS_MEMORY_DIR

_origin_of() { git -C "$1" remote get-url origin 2>/dev/null || true; }

# url, then the value of the legacy per-purpose key (empty if unset).
_checkout_dir() {
  _cd_url="$1"; _cd_explicit="$2"
  # An explicit key still wins, exactly as before: a machine that already
  # names its checkout must not be moved by an upgrade.
  if [[ -n "$_cd_explicit" ]]; then printf '%s\n' "$_cd_explicit"; return; fi
  # Nothing configured: the parent is the honest answer, and the verbs refuse
  # on the missing URL rather than on a path.
  if [[ -z "$_cd_url" ]]; then printf '%s\n' "$FLOPPY_AGENTS_MEMORY_DIR"; return; fi
  # Name the directory after the repository in the URL. The colon strip is for
  # the scp-style form with no path segment (git@host:repo.git), where cutting
  # at the last slash alone would leave "git@host:repo" as a directory name.
  _cd_slug="${_cd_url%/}"; _cd_slug="${_cd_slug##*/}"; _cd_slug="${_cd_slug##*:}"
  _cd_slug="${_cd_slug%.git}"
  # Clones live under .clones/ so that the parent holds one alphabet only —
  # project keys, which is what a human looks for there. A flat parent mixed
  # project names with repository names, and telling them apart needed the
  # config open beside the terminal.
  _cd_derived="$FLOPPY_AGENTS_MEMORY_DIR/.clones/$_cd_slug"
  if [[ -d "$_cd_derived/.git" ]]; then printf '%s\n' "$_cd_derived"; return; fi
  # Two older layouts, adopted rather than re-cloned, and each only when its
  # origin proves it is this very repository. Anything less than that proof
  # would be the silent adoption these checks exist to stop: a directory
  # holding some other repository falls through to the derived path, where the
  # verb's own origin check has the last word.
  #   0.4.2: one checkout per URL, directly under the parent.
  if [[ -d "$FLOPPY_AGENTS_MEMORY_DIR/$_cd_slug/.git" ]] \
     && [[ "$(_origin_of "$FLOPPY_AGENTS_MEMORY_DIR/$_cd_slug")" == "$_cd_url" ]]; then
    printf '%s\n' "$FLOPPY_AGENTS_MEMORY_DIR/$_cd_slug"; return
  fi
  #   before 0.4.2: one checkout, at the parent itself.
  if [[ -d "$FLOPPY_AGENTS_MEMORY_DIR/.git" ]] \
     && [[ "$(_origin_of "$FLOPPY_AGENTS_MEMORY_DIR")" == "$_cd_url" ]]; then
    printf '%s\n' "$FLOPPY_AGENTS_MEMORY_DIR"; return
  fi
  printf '%s\n' "$_cd_derived"
}

export FLOPPY_WORKPLACE_MEMORY_DIR="$(_checkout_dir "$FLOPPY_WORKPLACE_REPO" "$(cfg_get workplace_memory_dir '')")"
# A fact about the harness, not about this project: its session loader
# truncates the memory index past a size of its own and says nothing about the
# tail it dropped. Shipped with the number measured on Claude Code and
# overridden by a consumer whose harness cuts elsewhere. The per-corpus caps
# (how many pointers, how long a pointer line, how big the memory) live in
# quota.lock instead, inside the memory itself — see the memory-lint header.
# The private scope inside the memory: facts about this project that the code
# repository must not carry — somebody else's checkout, an access note, a
# reading of a client's source. It is NOT machine-local, which is what its old
# name `local` said and what it stopped being when it became a symlink into a
# shared repository. Machine facts live in machines/<name>/ of that repository
# instead, where the other machine can read them.
#
# memory_local_dir still works, for a config written before 0.6.0. Only the
# NAME is configurable; the rule that committed memory must not link into this
# scope is not.
export FLOPPY_MEMORY_PRIVATE_DIR="$(cfg_get memory_private_dir "$(cfg_get memory_local_dir private)")"
# The old variable name, for a plugin script or a project hook still reading it.
export FLOPPY_MEMORY_LOCAL_DIR="$FLOPPY_MEMORY_PRIVATE_DIR"
# Where this project's memory is hosted when it cannot live in this repository.
# No defaults, deliberately: a project that never opted in must not be pointed
# at somebody else's store. Read by `store`; the rest of the rite derives the
# layout from the filesystem instead.
export FLOPPY_MEMORY_REPO="$(cfg_get memory_repo '')"
export FLOPPY_MEMORY_PROJECT_KEY="$(cfg_get memory_project_key "$FLOPPY_PROJECT_KEY")"
export FLOPPY_MEMORY_REPO_DIR="$(_checkout_dir "$FLOPPY_MEMORY_REPO" "$(cfg_get memory_repo_dir '')")"
export FLOPPY_INDEX_CHARS_MAX="$(cfg_get index_chars_max 24500)"
export FLOPPY_STATUSES_NOW="$(cfg_get statuses_now docs/statuses/NOW.md)"
export FLOPPY_STATUSES_NOW_CHARS_MAX="$(cfg_get statuses_now_chars_max 12000)"
export FLOPPY_WATCHED_DIRS="$(cfg_get watched_dirs docs)"
export FLOPPY_WATCHED_FILES="$(cfg_get watched_files AGENTS.md)"
# Where a repository keeps the rite as command files in its own language, if it
# keeps them at all. Only `parity` reads this; a repository that invokes the
# English skills directly has no such directory and that verb says so instead
# of failing.
export FLOPPY_COMMANDS_DIR="$(cfg_get commands_dir .claude/commands)"
# auto: pull --rebase then push, same as always. never: wrap-commit stays
# local — commits but does not touch a remote at all. For a repository with
# no upstream configured, "auto" fails the sync step every time (there is
# nothing to pull or push against), so that repository sets commit_push=never.
export FLOPPY_COMMIT_PUSH="$(cfg_get commit_push auto)"

# Every verb below acts on FLOPPY_REPO, resolved above, and several projects
# can be open in the same harness at once (Cursor especially) with no other
# indication which one a given shell landed in. Naming it costs nothing — the
# value is already computed — so it is the first line of every verb's output,
# in one shape, printed here rather than duplicated in each script. `commit`
# additionally names the branch and push target itself, before its gates run:
# see wrap-commit.sh.
name_repo() { printf 'repo: %s\n' "$FLOPPY_REPO"; }

# The mirror of the unknown-verb case below, and it travels the other way. This
# file is committed in the consumer repository, so it reaches a second machine
# with `git pull` — while the plugin it dispatches into is installed per
# machine and does not. A verb added upstream therefore arrives here first and
# finds no script behind it, and `exec` alone would report that as a bare "No
# such file or directory" naming a path inside a plugin cache, which reads like
# a broken install rather than an un-updated one.
run_script() { # script-name, then its args
  local s="$FLOPPY_ROOT/scripts/$1"; shift
  if [[ ! -f "$s" ]]; then
    echo "x this repository's .floppy/run knows verb '$verb', but the installed plugin has no $(basename "$s")" >&2
    echo "  The shim travels with the repository (git); the plugin is installed per machine." >&2
    echo "  This machine's plugin is behind: update it, and remember that \`plugin update\`" >&2
    echo "  is a no-op while the version string is unchanged." >&2
    echo "  Resolved plugin root: $FLOPPY_ROOT" >&2
    exit 1
  fi
  exec bash "$s" "$@"
}

verb="${1:-}"; shift 2>/dev/null || true
case "$verb" in
  env)       env | grep '^FLOPPY_' | sort ;;
  lint)      name_repo; run_script memory-lint.sh      "$@" ;;
  link)      name_repo; run_script memory-link.sh      "$@" ;;
  workplace) name_repo; run_script memory-workplace.sh "$@" ;;
  store)     name_repo; run_script memory-store.sh     "$@" ;;
  guard)     name_repo; run_script wrap-guard.sh       "$@" ;;
  lock)                 run_script wrap-lock.sh        "$@" ;;
  status)    name_repo; run_script workstatus.sh       "$@" ;;
  parity)    name_repo; run_script parity.sh           "$@" ;;
  check)     name_repo; run_script wrap-check.sh       "$@" ;;
  commit)    name_repo; run_script wrap-commit.sh      "$@" ;;
  ""|help)   echo "usage: bash .floppy/run {env|lint|link|workplace|store|guard|lock|status|parity|check|commit}" ;;
  # A verb this copy has never heard of is as likely to mean a stale shim as a
  # typo, and the two look identical from here. `.floppy/run` is the one file
  # this plugin puts in a consumer repository, so it does NOT arrive with
  # `plugin update` the way scripts/ and skills/ do: a verb added upstream
  # stays unreachable until the copy is refreshed. Measured the first time a
  # verb was added after extraction (`parity`, 2026-08-25) — the plugin was
  # current, the repository's shim was not, and the error said only "unknown".
  *)         echo "x unknown verb: $verb" >&2
             echo "  known: env lint link workplace store guard lock status parity check commit" >&2
             echo "  If it exists upstream, this copy of .floppy/run is behind — it is a" >&2
             echo "  copy, not a link, and \`plugin update\` does not touch it. Refresh it:" >&2
             echo "    cp \"\$FLOPPY_ROOT/shim/run\" .floppy/run   (or re-run the init skill)" >&2
             exit 2 ;;
esac
