#!/usr/bin/env bash
# The only file of this plugin that lands in a consumer repository, as
# .floppy/run. It does two things nobody else may do: locate the plugin, and
# parse .floppy/config. Everything downstream reads FLOPPY_* from the
# environment, so there is exactly one parser and one search order.
set -uo pipefail

# Loud on purpose: every verb below trusts FLOPPY_REPO as the root all its
# paths are relative to. A silent `|| pwd` fallback here would mean a run
# from outside any git repository quietly derives every downstream path —
# memory dir, statuses file, watched dirs — from the wrong place instead of
# failing where the mistake is obvious.
if ! FLOPPY_REPO="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "x not inside a git repository: $(pwd)" >&2
  echo "  floppy's session ritual is git-based; cd into the repository first" >&2
  exit 1
fi
export FLOPPY_REPO

# The plugin cache path carries a version and changes on every update, so the
# only stable handles are the harness variable and an explicit override.
#
# skills/init/SKILL.md duplicates this exact search rather than sourcing it
# from here: `floppy:init` runs before this file exists in the target
# repository (creating it is init's own first step), so it cannot read this
# copy. Keep the two in sync by hand if this search ever changes.
if   [[ -n "${CLAUDE_PLUGIN_ROOT:-}" && -d "${CLAUDE_PLUGIN_ROOT}/scripts" ]]; then
  FLOPPY_ROOT="$CLAUDE_PLUGIN_ROOT"
elif [[ -n "${AI_FLOPPY_HOME:-}"     && -d "${AI_FLOPPY_HOME}/scripts"     ]]; then
  FLOPPY_ROOT="$AI_FLOPPY_HOME"
else
  FLOPPY_ROOT="$(ls -d "$HOME"/.claude/plugins/cache/*/floppy/*/ 2>/dev/null | sort -V | tail -n1)"
fi

if [[ -z "${FLOPPY_ROOT:-}" || ! -d "$FLOPPY_ROOT/scripts" ]]; then
  echo "x floppy plugin not found." >&2
  echo "  Install it, or point AI_FLOPPY_HOME at a checkout:" >&2
  echo "      /plugin marketplace add spscream/ai_floppy && /plugin install floppy" >&2
  exit 1
fi
export FLOPPY_ROOT

# Flat key=value, like quota.lock. Nested YAML cannot be parsed by bash 3.2
# without a hand-rolled parser, and a hand-rolled config parser fails quietly.
cfg="$FLOPPY_REPO/.floppy/config"
cfg_get() { # key default
  local line="" v=""
  [[ -f "$cfg" ]] && line="$(grep -m1 "^[[:space:]]*$1[[:space:]]*=" "$cfg" 2>/dev/null || true)"
  if [[ -z "$line" ]]; then printf '%s' "$2"; return; fi
  v="${line#*=}"
  v="${v#"${v%%[![:space:]]*}"}"   # leading
  v="${v%"${v##*[![:space:]]}"}"   # trailing
  printf '%s' "$v"
}

# memory_language is deliberately not exported: it governs the language a
# note's prose is written in, which is a convention the agent reads out of
# .floppy/config directly (see floppy:agent-memory) — no script here acts on
# it. An env var nothing consumes is worse than no var: it looks wired.
export FLOPPY_MEMORY_DIR="$(cfg_get memory_dir .agent-memory)"
export FLOPPY_WORKPLACE_REPO="$(cfg_get workplace_repo '')"
export FLOPPY_WORKPLACE_PROJECT_KEY="$(cfg_get workplace_project_key '')"
# $HOME/agents_memory is only a default, not a rule: it is one person's own
# checkout name, and a consumer whose workplace checkout lives elsewhere sets
# workplace_memory_dir in .floppy/config rather than symlinking to match it.
export FLOPPY_WORKPLACE_MEMORY_DIR="$(cfg_get workplace_memory_dir "$HOME/agents_memory")"
export FLOPPY_STATUSES_NOW="$(cfg_get statuses_now docs/statuses/NOW.md)"
export FLOPPY_STATUSES_NOW_CHARS_MAX="$(cfg_get statuses_now_chars_max 12000)"
export FLOPPY_WATCHED_DIRS="$(cfg_get watched_dirs docs)"
export FLOPPY_WATCHED_FILES="$(cfg_get watched_files AGENTS.md)"
# auto: pull --rebase then push, same as always. never: wrap-commit stays
# local — commits but does not touch a remote at all. For a repository with
# no upstream configured, "auto" fails the sync step every time (there is
# nothing to pull or push against), so that repository sets commit_push=never.
export FLOPPY_COMMIT_PUSH="$(cfg_get commit_push auto)"

verb="${1:-}"; shift 2>/dev/null || true
case "$verb" in
  env)       env | grep '^FLOPPY_' | sort ;;
  lint)      exec bash "$FLOPPY_ROOT/scripts/memory-lint.sh"      "$@" ;;
  link)      exec bash "$FLOPPY_ROOT/scripts/memory-link.sh"      "$@" ;;
  workplace) exec bash "$FLOPPY_ROOT/scripts/memory-workplace.sh" "$@" ;;
  guard)     exec bash "$FLOPPY_ROOT/scripts/wrap-guard.sh"       "$@" ;;
  lock)      exec bash "$FLOPPY_ROOT/scripts/wrap-lock.sh"        "$@" ;;
  status)    exec bash "$FLOPPY_ROOT/scripts/workstatus.sh"       "$@" ;;
  check)     exec bash "$FLOPPY_ROOT/scripts/wrap-check.sh"       "$@" ;;
  commit)    exec bash "$FLOPPY_ROOT/scripts/wrap-commit.sh"      "$@" ;;
  ""|help)   echo "usage: bash .floppy/run {env|lint|link|workplace|guard|lock|status|check|commit}" ;;
  *)         echo "x unknown verb: $verb" >&2; exit 2 ;;
esac
