.DS_Store

# plan-execution scratch directory: drafts, not history
.superpowers/

# assembled documentation site: every file in it is generated from a document
# that is already tracked, and committing it would create the second, drifting
# copy the build exists to prevent
.site/
_site/


# floppy: the note-open log the heat verb keeps — per-checkout working data,
# never memory. Ignored here in the same PR that shipped the verb, because
# this repository's wrap may only commit watched paths and a first `heat`
# call would otherwise leave .gitignore dirtied by a line wrap cannot commit
.floppy/heat.log*

# memory lives in the store repository, not here
/.agent-memory

# floppy: the private memory scope — a symlink into the private memory
# repository, never committed here (see agent-memory)
/.agent-memory/private

# Python bytecode: generated on every run of the knowledge scripts, and one
# stray `git add -A` is all it takes to commit a binary nobody reads
__pycache__/
*.pyc

# floppy: subagent memory and this machine's local overrides are working state,
# not history. `.claude/settings.json` IS tracked — it carries the project's own
# permission rules, and a rule nobody else gets is a rule that does not hold.
/.claude/agent-memory/
/.claude/settings.local.json
