.DS_Store

# plan-execution scratch directory: drafts, not history
.superpowers/

# assembled documentation site: every file in it is generated from a document
# that is already tracked, and committing it would create the second, drifting
# copy the build exists to prevent
.site/
_site/


# memory lives in the store repository, not here
/.agent-memory

# floppy: the private memory scope — a symlink into the private memory
# repository, never committed here (see agent-memory)
/.agent-memory/private

# Python bytecode: generated on every run of the knowledge scripts, and one
# stray `git add -A` is all it takes to commit a binary nobody reads
__pycache__/
*.pyc
