#!/usr/bin/env bash
# The dispatcher: one verb in, one script out. Lives in the PLUGIN and is
# called directly:
#
#   bash <plugin>/scripts/run <verb>
#
# Every skill this plugin ships is handed its own absolute base directory when
# the harness loads it (measured 2026-09-22: "Base directory for this skill:
# <plugin>/skills/<name>"), so the caller already knows where the plugin is,
# and this file is two directories above that.
#
# Why there is no copy in the consumer repository (0.26.0). Until then the call
# went through `.floppy/run`, a COPY of shim/run carried by the consumer's git
# and untouched by `plugin update`, whose whole job was to find the plugin. It
# went stale silently: measured over the first 24 commits that touched it, at
# least 7 changed only the config parser or this verb table, so a third of the
# refreshes it demanded of every consumer bought them nothing. The verb table
# and the parser moved here in 0.14.0; 0.26.0 removed the copy itself, because
# a caller that is TOLD where the plugin is needs no file in the repository to
# compute it.
#
# `shim/run` still ships, for the consumers who already carry a copy and for a
# call with no stated root to work from. Nothing here depends on it.
#
# Runs on macOS bash 3.2: no mapfile, no declare -A, no GNU-only flags.
set -uo pipefail

# ---------- where the plugin is: this file's own directory, one level up ----
# The file whose location is wanted is the file being executed, so there is
# nothing to search for and no variable to require. Measured 2026-09-22: with
# FLOPPY_ROOT unset, a bare `bash <plugin>/scripts/run status` died at this
# file's first use of it — `FLOPPY_ROOT: unbound variable`, a raw bash error —
# which is why the call used to have to go through the consumer's copy.
#
# Derived unconditionally, not merely when unset: a FLOPPY_ROOT naming some
# OTHER copy of the plugin would send every verb into that copy's scripts while
# this one dispatches, which is the "a script that had just been fixed was
# reported as still broken" failure shim/run's own header records. The path a
# call was made through is the truth about which copy is running.
# CDPATH, exported with a relative entry in it, makes `cd` print the directory
# it found on stdout. Inside the substitution below that lands in FLOPPY_ROOT,
# which then holds two lines and sources nothing. Measured 2026-09-25, 3/3:
# with CDPATH=.:/tmp, `bash scripts/run status` — the relative spelling
# CLAUDE.md documents — died in lib-config.sh and blamed the install
# ("Reinstall the plugin"), which was not the cause. Unset rather than worked
# around here, because it is then gone from what every verb inherits too.
unset CDPATH

FLOPPY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
export FLOPPY_ROOT

# How a message spells a floppy command. Every hint a verb prints names this
# dispatcher by its absolute path, because the consumer's repository no longer
# holds a short relative name for it — and an absolute path is pasteable from
# whatever directory the reader happens to be standing in. Quoted only when it
# has to be: quotes in every hint are noise, and an unquoted path with a space
# in it is a broken command.
case "$FLOPPY_ROOT" in
  *[[:space:]]*) FLOPPY_RUN="bash \"$FLOPPY_ROOT/scripts/run\"" ;;
  *)             FLOPPY_RUN="bash $FLOPPY_ROOT/scripts/run" ;;
esac
export FLOPPY_RUN

# Loud on purpose: every verb below trusts FLOPPY_REPO as the root all its
# paths are relative to. A silent `|| pwd` fallback here would mean a run
# from outside any git repository quietly derives every downstream path —
# memory dir, statuses file, watched dirs — from the wrong place instead of
# failing where the mistake is obvious.
if ! FLOPPY_REPO="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "x not inside a git repository: $(pwd)" >&2
  echo "  floppy's session ritual is git-based; cd into the repository first" >&2
  exit 1
fi
export FLOPPY_REPO

# `--check` means report only, change nothing, and two verbs promise it in their
# own headers. The config parser makes the harness's memory pointer as a side
# effect of being read (see auto_harness_link), which would break that promise
# on the one call a person makes precisely because they do not want anything
# touched. Decided here because this is where the arguments are; the parser
# never sees them.
#
# Any `--check` anywhere in the line, not just the first argument: it is the
# reporting flag of every verb that has one, and a future verb that grows one
# gets this for free.
for _arg in "$@"; do
  [[ "$_arg" == "--check" ]] && export FLOPPY_AUTOLINK=0
done
unset _arg

# One parser for the whole plugin, in the plugin.
. "$FLOPPY_ROOT/scripts/lib-config.sh"

# Every verb below acts on FLOPPY_REPO, resolved above, and several projects
# can be open in the same harness at once (Cursor especially) with no other
# indication which one a given shell landed in. Naming it costs nothing — the
# value is already computed — so it is the first line of every verb's output,
# in one shape, printed here rather than duplicated in each script. `commit`
# additionally names the branch and push target itself, before its gates run:
# see wrap-commit.sh.
name_repo() { printf 'repo: %s\n' "$FLOPPY_REPO"; }

# This file and the scripts it names ship together, so a missing one is a
# broken install rather than a version skew — which is exactly what changed in
# 0.14.0: the verb table used to live in the consumer's copy, where it could be
# newer than the plugin it dispatched into. `exec` alone reports the case as a
# bare "No such file or directory" naming a path inside a plugin cache, which
# reads like a bug in the rite.
run_script() { # script-name, then its args
  local s="$FLOPPY_ROOT/scripts/$1"; shift
  if [[ ! -f "$s" ]]; then
    echo "x verb '$verb' resolves to $(basename "$s"), which this plugin copy does not have" >&2
    echo "  The install is incomplete, not out of date: this dispatcher and that script" >&2
    echo "  are shipped together. Reinstall the plugin, and remember that \`plugin update\`" >&2
    echo "  is a no-op while the version string is unchanged." >&2
    echo "  Resolved plugin root: $FLOPPY_ROOT" >&2
    exit 1
  fi
  # $BASH, not a bare `bash`: whoever chose an interpreter for this dispatcher
  # chose it for the verb too. A bare `bash` re-resolves through PATH, where a
  # Homebrew bash 5 sits ahead of /bin/bash on macOS — so `/bin/bash scripts/run
  # status` ran memory-lint.sh and workstatus.sh on 5.x, and CI's macos-bash-3-2
  # job tested 3.2 for the test files and nothing else (measured 2026-09-08).
  exec "${BASH:-bash}" "$s" "$@"
}

verb="${1:-}"; shift 2>/dev/null || true
case "$verb" in
  env)       env | grep '^FLOPPY_' | sort ;;
  lint)      name_repo; run_script memory-lint.sh      "$@" ;;
  link)      name_repo; run_script memory-link.sh      "$@" ;;
  workplace) name_repo; run_script memory-workplace.sh "$@" ;;
  store)     name_repo; run_script memory-store.sh     "$@" ;;
  guard)     name_repo; run_script wrap-guard.sh       "$@" ;;
  # heat skips name_repo like lock does: it is called mid-task every time a
  # note is opened, and a banner per read teaches the caller to stop calling.
  heat)                 run_script memory-heat.sh      "$@" ;;
  lock)                 run_script wrap-lock.sh        "$@" ;;
  status)    name_repo; run_script workstatus.sh       "$@" ;;
  check)     name_repo; run_script wrap-check.sh       "$@" ;;
  commit)    name_repo; run_script wrap-commit.sh      "$@" ;;
  ""|help)   echo "usage: $FLOPPY_RUN {env|lint|link|workplace|store|guard|heat|lock|status|check|commit}" ;;
  # Until 0.14.0 this table lived in the consumer's copy of the shim, and an
  # unknown verb there was as likely to mean a stale copy as a typo — the two
  # were indistinguishable from inside the file. Measured the first time a verb
  # was added after extraction (`parity`, 2026-08-25): the plugin was current,
  # the repository's copy was not, and the message said only "unknown". Now the
  # table is in the plugin, so this branch can only be a typo or a plugin too
  # old for the verb — and a verb added upstream no longer needs anyone to
  # re-copy anything.
  *)         echo "x unknown verb: $verb" >&2
             echo "  known: env lint link workplace store guard heat lock status check commit" >&2
             echo "  If it exists upstream, this machine's plugin is behind: update it, and" >&2
             echo "  remember that \`plugin update\` is a no-op while the version is unchanged." >&2
             echo "  Resolved plugin root: $FLOPPY_ROOT" >&2
             exit 2 ;;
esac